[Unit]
Description=Instrument Cluster Application
After=systemd-udev-settle.service hu-mainapp-compositor.service
Requires=systemd-udev-settle.service
StartLimitInterval=60s
StartLimitBurst=3

[Service]
Type=simple
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/IC_app
Restart=on-failure
RestartSec=5

# Set proper environment for EGLFS KMS on DSI display
Environment="QT_QPA_PLATFORM=eglfs"
Environment="QT_QPA_EGLFS_INTEGRATION=eglfs_kms"
Environment="QT_QPA_EGLFS_KMS_CONFIG=/etc/eglfs-kms-dsi.json"
Environment="XDG_RUNTIME_DIR=/run/user/0"
Environment="QT_PLUGIN_PATH=/usr/lib/plugins"
Environment="LD_LIBRARY_PATH=/usr/lib:/usr/local/lib"

# Run as root
User=root

StandardOutput=journal
StandardError=journal
SyslogIdentifier=IC_app

[Install]
WantedBy=multi-user.target
